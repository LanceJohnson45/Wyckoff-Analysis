# Operator-only references; keep the installed copy mode 0600. No credentials here.
STOCK_RESEARCH_MVP_SOURCE_ROOT=/absolute/path/to/market-source-release
STOCK_RESEARCH_MVP_SOURCE_ENV_FILE=/absolute/private/path/source.env
STOCK_RESEARCH_MVP_PERSONAL_ROOT=/absolute/path/to/installed-personal-services
STOCK_RESEARCH_MVP_PERSONAL_ENV_FILE=/absolute/private/path/personal.env
STOCK_RESEARCH_MVP_UNIVERSE_PATH=/absolute/path/to/universe.json
STOCK_RESEARCH_MVP_WORKFLOW_IDENTITY_FILE=/absolute/private/path/workflow.env
STOCK_RESEARCH_MVP_STATE_PATH=/absolute/private/path/publications
