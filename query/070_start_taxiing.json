{
  "name": "开始滑跑",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [224, 225, 226],
  "source": "开始滑跑指股价进入起飞线后，出现放量上行的初动阶段；刚开始滑跑时上涨速度较慢，但成交量消耗较大，随后才会进入加速滑跑或拉升阶段。",
  "source_summary": "若进入起飞线后股价仍站在60日线之上并保持放量缓升，可视为开始滑跑。",
  "comment": "当前提取为进入起飞线后的持续放量上行阶段。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close", "volume"],
  "warmup_bars": 90,
  "indicator_type": "trend_rule",
  "params": {
    "ma_long_window": 60,
    "volume_ma_window": 20,
    "setup_lookback": 15,
    "signal_keep_days": 5
  },
  "series": [
    {"id": "ma_long", "op": "sma", "field": "close", "window": "$params.ma_long_window", "description": "60日均线"},
    {"id": "volume_ma", "op": "sma", "field": "volume", "window": "$params.volume_ma_window", "description": "20日量均线"},
    {"id": "close_ref_5", "op": "ref", "field": "close", "window": 5, "description": "5日前收盘价"}
  ],
  "events": [
    {"id": "cross_ma_long", "op": "cross_up", "left": "close", "right": "ma_long", "description": "股价上穿60日均线"}
  ],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "before",
            "condition": {"op": "condition", "event": "cross_ma_long"},
            "event": "cross_ma_long",
            "window": "$params.setup_lookback",
            "min_count": 1
          },
          {"op": "compare", "left": "close", "operator": ">", "right": "ma_long"},
          {"op": "compare", "left": "volume", "operator": ">", "right": "volume_ma"},
          {"op": "compare", "left": "close", "operator": ">", "right": "close_ref_5"}
        ]
      }
    }
  },
  "calculation_steps": [
    "确认近期已经出现进入起飞线式的上穿60日均线。",
    "要求当前仍站在60日线之上，并保持量能高于量均线。",
    "用当前收盘高于5日前收盘价，近似表达开始滑跑中的缓慢上行。"
  ],
  "signal_day_definition": "当进入起飞线后仍处于放量缓升状态的最新交易日，视为开始滑跑有效。",
  "manual_review_needed": [
    "原文还区分后续的加速滑跑阶段，当前只输出起始滑跑版本。"
  ],
  "implementation_notes": [
    "这是一个过程状态规则。"
  ],
  "explain": "开始滑跑被结构化为进入起飞线后的放量缓慢上行阶段。"
}
