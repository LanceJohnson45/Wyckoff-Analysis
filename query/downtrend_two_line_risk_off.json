{
  "name": "跌势两线避险法",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [508, 509, 510],
  "source": "跌势两线避险法的核心是：5日、10日均价线死亡交叉后坚决不操作，一直到再次黄金交叉；同时若MACD的DIF位于零轴下方，也属于绿色海洋区间，同样不操作。只有5日线上冲10日线且DIF重新站上零轴，才考虑恢复做多。",
  "source_summary": "若5/10日均线死叉且DIF位于零轴下方，则处于典型跌势避险区。",
  "comment": "当前 latest_match 提取的是“风险规避状态”，不是“恢复做多”的入场状态。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close"],
  "warmup_bars": 60,
  "indicator_type": "trend_rule",
  "params": {
    "ema_fast_window": 12,
    "ema_slow_window": 26,
    "signal_keep_days": 5
  },
  "series": [
    {
      "id": "ma_5",
      "op": "sma",
      "field": "close",
      "window": 5,
      "description": "5日均线"
    },
    {
      "id": "ma_10",
      "op": "sma",
      "field": "close",
      "window": 10,
      "description": "10日均线"
    },
    {
      "id": "ema_fast",
      "op": "ema",
      "field": "close",
      "window": "$params.ema_fast_window",
      "description": "MACD快线EMA"
    },
    {
      "id": "ema_slow",
      "op": "ema",
      "field": "close",
      "window": "$params.ema_slow_window",
      "description": "MACD慢线EMA"
    },
    {
      "id": "macd_dif",
      "op": "sub",
      "field": "ema_fast",
      "field2": "ema_slow",
      "window": 0,
      "description": "MACD DIF"
    }
  ],
  "events": [
    {
      "id": "death_cross_5_10",
      "op": "cross_down",
      "left": "ma_5",
      "right": "ma_10",
      "description": "5日线下穿10日线"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "compare",
            "left": "ma_5",
            "operator": "<",
            "right": "ma_10"
          },
          {
            "op": "compare",
            "left": "macd_dif",
            "operator": "<",
            "right": 0
          },
          {
            "op": "condition",
            "event": "death_cross_5_10"
          }
        ]
      }
    }
  },
  "calculation_steps": [
    "计算5日、10日均线和MACD DIF。",
    "识别5日线下穿10日线的死叉时点。",
    "要求死叉后DIF仍位于零轴下方，确认处于绿色海洋的避险区。"
  ],
  "signal_day_definition": "以5/10日均线死叉且DIF位于零轴下方的当日作为避险信号确认日。",
  "manual_review_needed": [
    "原文更偏‘期间不操作’的方法论，当前将其结构化为风险状态触发点。"
  ],
  "implementation_notes": [
    "warmup_bars >= ema_slow_window + 10 + 1。"
  ],
  "explain": "该规则用于识别5/10日死叉并伴随DIF零下运行的典型熊市避险区。"
}
