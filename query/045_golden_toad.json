{
  "name": "金蛤蟆",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [156, 157, 158, 159],
  "source": "金蛤蟆采用5、10、60日均线系统，股价先形成左眼与左爪，再形成右眼，随后回落到60日均线附近形成右爪，右爪下还会出现量芝麻点，之后一旦冲过蛤蟆眼睛则上涨确认。",
  "source_summary": "若股价回落到60日线附近缩量完成右爪，然后突破前高眼位，可视为金蛤蟆完成。",
  "comment": "当前主规则聚焦‘右爪缩量靠近60日线后突破双眼高点’这一最可执行部分。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close", "volume"],
  "warmup_bars": 120,
  "indicator_type": "pattern_rule",
  "params": {
    "ma_fast_window": 5,
    "ma_mid_window": 10,
    "ma_long_window": 60,
    "eye_lookback": 40,
    "volume_ma_window": 20,
    "setup_lookback": 20,
    "low_volume_days": 3,
    "signal_keep_days": 5
  },
  "series": [
    {"id": "ma_fast", "op": "sma", "field": "close", "window": "$params.ma_fast_window", "description": "5日均线"},
    {"id": "ma_mid", "op": "sma", "field": "close", "window": "$params.ma_mid_window", "description": "10日均线"},
    {"id": "ma_long", "op": "sma", "field": "close", "window": "$params.ma_long_window", "description": "60日均线"},
    {"id": "eye_high", "op": "highest", "field": "close", "window": "$params.eye_lookback", "description": "蛤蟆双眼高点近似"},
    {"id": "eye_high_prev", "op": "ref", "field": "eye_high", "window": 1, "description": "前一日双眼高点"},
    {"id": "volume_ma", "op": "sma", "field": "volume", "window": "$params.volume_ma_window", "description": "成交量均线"}
  ],
  "events": [
    {"id": "breakout_eye", "op": "breakout_up", "left": "close", "right": "eye_high_prev", "description": "收盘突破蛤蟆眼睛高点"}
  ],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "before",
            "condition": {
              "op": "and",
              "conditions": [
                {"op": "compare", "left": "close", "operator": ">=", "right": "ma_long"},
                {"op": "compare", "left": "volume", "operator": "<=", "right": "volume_ma"}
              ]
            },
            "event": "breakout_eye",
            "window": "$params.setup_lookback",
            "min_count": "$params.low_volume_days"
          },
          {"op": "condition", "event": "breakout_eye"},
          {"op": "compare", "left": "ma_fast", "operator": ">=", "right": "ma_mid"}
        ]
      }
    }
  },
  "calculation_steps": [
    "计算5/10/60日均线，近似识别右爪阶段是否回到60日线附近。",
    "在突破前要求setup_lookback日内至少出现low_volume_days天的缩量状态，以近似右爪下的量芝麻点。",
    "以收盘突破eye_lookback窗口中的双眼高点作为金蛤蟆完成确认。"
  ],
  "signal_day_definition": "以突破蛤蟆眼睛高点的当日作为金蛤蟆信号完成日。",
  "manual_review_needed": [
    "左右眼、左右爪与悬空右爪等细节尚未逐段精确建模，当前按右爪缩量后突破眼位近似提取。"
  ],
  "implementation_notes": [
    "warmup_bars >= ma_long_window + eye_lookback + 1。"
  ],
  "explain": "金蛤蟆被结构化为回踩60日线缩量洗盘后突破前高的底部建仓形态。"
}
