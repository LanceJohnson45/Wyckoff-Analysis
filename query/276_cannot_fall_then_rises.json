{
  "name": "跌不下去就涨",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [853, 854, 855, 856],
  "source": "跌不下去就涨强调：在暖气带向上的前提下，股价回档或巩固形态虽然看似承压，但如果始终跌不下去、最终重新走强并向上突破，就说明洗盘完成、涨势将延续。",
  "source_summary": "若暖气带仍向上且股价回档后重新站上五线并转强，可视为跌不下去就涨成立。",
  "comment": "当前用日线版‘暖气带向上 + 重返五线’来近似原文的跟随法则。"
  ,
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close"],
  "warmup_bars": 140,
  "indicator_type": "trend_rule",
  "params": {
    "signal_keep_days": 5
  },
  "series": [
    {
      "id": "ma_5",
      "op": "sma",
      "field": "close",
      "window": 5,
      "description": "5日均线"
    },
    {
      "id": "ma_10",
      "op": "sma",
      "field": "close",
      "window": 10,
      "description": "10日均线"
    },
    {
      "id": "ma_20",
      "op": "sma",
      "field": "close",
      "window": 20,
      "description": "20日均线"
    },
    {
      "id": "ma_60",
      "op": "sma",
      "field": "close",
      "window": 60,
      "description": "60日均线"
    },
    {
      "id": "ma_120",
      "op": "sma",
      "field": "close",
      "window": 120,
      "description": "120日均线"
    }
  ],
  "events": [
    {
      "id": "reclaim_five_lines",
      "op": "cross_up",
      "left": "close",
      "right": "ma_120",
      "description": "收盘重新回到五线系统上方的关键动作近似"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "condition",
            "event": "reclaim_five_lines"
          },
          {
            "op": "compare",
            "left": "ma_60",
            "operator": ">=",
            "right": "ma_120"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": ">",
            "right": "ma_5"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": ">",
            "right": "ma_10"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": ">",
            "right": "ma_20"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": ">",
            "right": "ma_60"
          }
        ]
      }
    }
  },
  "calculation_steps": [
    "计算5、10、20、60、120日均线。",
    "要求暖气带即60/120线仍保持向上强势近似关系。",
    "当股价回档后重新回到五线之上时，视为跌不下去就涨成立。"
  ],
  "signal_day_definition": "以股价回档后重新回到五线之上的当日作为确认日。",
  "manual_review_needed": [
    "原文还结合更细的三角形和盘中突破过程，当前主规则只保留日线结果态。"
  ],
  "implementation_notes": [
    "这是原文‘跟随法’在日线级别上的近似执行版本。"
  ],
  "explain": "跌不下去就涨被结构化为暖气带仍强的前提下，股价回档后重新回到五线之上。"
}
