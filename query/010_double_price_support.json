{
  "name": "双价托",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [45, 46, 47, 48],
  "source": "双价托指一轮上升过程中先后形成两个价托，第二个价托可以是水平双托，也可以是一低一高的双托，说明股价获得双重支撑。",
  "source_summary": "在较长窗口内先后两次形成价托，且最新仍处于第二个价托完成后的有效区间，可视为双价托。",
  "comment": "当前规则把双价托近似为较长窗口内至少出现两次5/10/20均线托结构完成事件。",
  "computable_from_daily_ocvhl": true,
  "required_fields": [
    "close"
  ],
  "warmup_bars": 120,
  "indicator_type": "pattern_rule",
  "params": {
    "ma_fast_window": 5,
    "ma_mid_window": 10,
    "ma_slow_window": 20,
    "double_support_lookback": 120,
    "recent_support_keep_days": 20,
    "sequence_lookback": 20,
    "allow_same_day": true
  },
  "series": [
    {
      "id": "ma_fast",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_fast_window",
      "description": "5日均线"
    },
    {
      "id": "ma_mid",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_mid_window",
      "description": "10日均线"
    },
    {
      "id": "ma_slow",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_slow_window",
      "description": "20日均线"
    }
  ],
  "events": [
    {
      "id": "cross_fast_mid",
      "op": "cross_up",
      "left": "ma_fast",
      "right": "ma_mid",
      "description": "5日均线上穿10日均线"
    },
    {
      "id": "cross_fast_slow",
      "op": "cross_up",
      "left": "ma_fast",
      "right": "ma_slow",
      "description": "5日均线上穿20日均线"
    },
    {
      "id": "cross_mid_slow",
      "op": "cross_up",
      "left": "ma_mid",
      "right": "ma_slow",
      "description": "10日均线上穿20日均线"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "and",
      "conditions": [
        {
          "op": "count",
          "window": "$params.double_support_lookback",
          "condition": {
            "op": "condition",
            "event": "cross_mid_slow"
          },
          "gte": 2
        },
        {
          "op": "within",
          "window": "$params.recent_support_keep_days",
          "condition": {
            "op": "sequence",
            "window": "$params.sequence_lookback",
            "allow_same_day": "$params.allow_same_day",
            "conditions": [
              {
                "op": "condition",
                "event": "cross_fast_mid"
              },
              {
                "op": "condition",
                "event": "cross_fast_slow"
              },
              {
                "op": "condition",
                "event": "cross_mid_slow"
              }
            ]
          }
        },
        {
          "op": "compare",
          "left": "ma_fast",
          "operator": ">=",
          "right": "ma_mid"
        },
        {
          "op": "compare",
          "left": "ma_mid",
          "operator": ">=",
          "right": "ma_slow"
        }
      ]
    }
  },
  "calculation_steps": [
    "计算5/10/20日均线及三次向上交叉事件。",
    "要求在double_support_lookback窗口内，至少出现两次 10日均线上穿20日均线 事件，近似表达两个价托完成。",
    "要求最近recent_support_keep_days日内又完成了一组按顺序的5/10/20均线托结构。",
    "要求最新交易日仍保持5/10/20均线多头排列。"
  ],
  "signal_day_definition": "以第二个价托完成后的有效区间作为双价托信号阶段；若最新交易日仍处于该区间并保持多头排列，则 latest_match = true。",
  "manual_review_needed": [
    "当前规则用“较长窗口内至少两次价托完成事件”近似双价托，尚未显式区分水平双托与一低一高双托。",
    "原文中的价托上平台突破买点未纳入主规则，如需更强右侧确认可后续追加。"
  ],
  "implementation_notes": [
    "该规则依赖对单价托的事件化近似。",
    "如果后续需要严格跟踪两个价托的相对高度，需要引擎支持事件时点价格引用。"
  ],
  "explain": "双价托目前被实现为同一较长窗口内先后两次价托完成，且最近一次仍有效。"
}
