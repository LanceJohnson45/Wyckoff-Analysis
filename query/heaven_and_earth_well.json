  "rules": {
    "latest_match": {
      "op": "and",
      "conditions": [
        {
          "op": "count",
          "window": "$params.signal_keep_days",
          "condition": {"op": "or", "conditions": [
            {"op": "condition", "event": "p_5_20"},
            {"op": "condition", "event": "p_10_20"},
            {"op": "condition", "event": "p_5_30"},
            {"op": "condition", "event": "p_10_30"}
          ]},
          "gte": 4
        },
        {
          "op": "count",
          "window": "$params.signal_keep_days",
          "condition": {"op": "or", "conditions": [
            {"op": "condition", "event": "v_5_20"},
            {"op": "condition", "event": "v_10_20"},
            {"op": "condition", "event": "v_5_30"},
            {"op": "condition", "event": "v_10_30"}
          ]},
          "gte": 4
        }
      ]
    }
  },
  "calculation_steps": [
    "计算价格与成交量的5/10/20/30日均线。",
    "统计最近signal_keep_days日内价格四个死亡交叉事件是否全部出现。",
    "统计最近signal_keep_days日内成交量四个死亡交叉事件是否全部出现。"
  ],
  "signal_day_definition": "以价格井字与量能井字都完成的窗口末端作为天上井地上井确认阶段。",
  "manual_review_needed": [
    "当前用滑动窗口内四个交叉都出现来近似井字完成，未单独要求图形上的紧凑程度。",
    "‘一井两压’未进一步拆成附加增强条件。"
  ],
  "implementation_notes": [
    "这是较复杂的多交叉共现头部规则。"
  ],
  "explain": "天上井地上井是价格与量能双重井字头部共振。"
