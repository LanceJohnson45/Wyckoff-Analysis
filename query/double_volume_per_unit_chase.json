{
  "name": "单位时间两倍量追涨法",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [561, 562, 563],
  "source": "单位时间两倍量追涨法强调：在形态已接近突破时，若当前操作单位时间内的成交量达到5单位和10单位均量线的两倍，并且后续量能还能持续放大，则可分批追进；若量不能持续，则不应继续追涨。",
  "source_summary": "若突破当日成交量达到中期均量的两倍并继续放大，可视为可追涨的量能确认。",
  "comment": "当前优先输出日线版本，把‘单位时间’近似为单日交易量。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close", "open", "volume"],
  "warmup_bars": 40,
  "indicator_type": "volume_price_rule",
  "params": {
    "volume_ma_window": 10,
    "volume_multiplier": 2,
    "breakout_lookback": 20,
    "signal_keep_days": 3
  },
  "series": [
    {
      "id": "volume_ma",
      "op": "sma",
      "field": "volume",
      "window": "$params.volume_ma_window",
      "description": "10日均量"
    },
    {
      "id": "double_volume_ma",
      "op": "mul",
      "field": "volume_ma",
      "field2": "$params.volume_multiplier",
      "window": 0,
      "description": "两倍10日均量"
    },
    {
      "id": "recent_high",
      "op": "highest",
      "field": "close",
      "window": "$params.breakout_lookback",
      "description": "近窗口最高收盘价"
    },
    {
      "id": "recent_high_prev",
      "op": "ref",
      "field": "recent_high",
      "window": 1,
      "description": "前一日近窗口最高收盘价"
    }
  ],
  "events": [
    {
      "id": "breakout_recent_high",
      "op": "breakout_up",
      "left": "close",
      "right": "recent_high_prev",
      "description": "收盘突破近期平台"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "condition",
            "event": "breakout_recent_high"
          },
          {
            "op": "compare",
            "left": "volume",
            "operator": ">=",
            "right": "double_volume_ma"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": ">",
            "right": "open"
          }
        ]
      }
    }
  },
  "calculation_steps": [
    "计算10日均量及其两倍阈值。",
    "识别股价对近期平台的向上突破。",
    "要求突破当日成交量达到两倍10日均量，且为阳线。"
  ],
  "signal_day_definition": "以放量达到两倍均量并完成平台突破的当日作为追涨确认日。",
  "manual_review_needed": [
    "原文还要求后续量能能够持续放大，当前主规则先保留首个有效追涨触发点。"
  ],
  "implementation_notes": [
    "warmup_bars >= max(volume_ma_window, breakout_lookback) + 1。"
  ],
  "explain": "该规则把单位时间两倍量追涨法压成日线版：突破时量能至少达到中期均量的两倍。"
}
