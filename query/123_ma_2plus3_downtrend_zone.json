{
  "name": "均线 2+3（五）",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [376, 377, 378],
  "source": "均线2+3（五）讨论下跌2&3区间和2-3中端：股价位于冷空气带下方，反弹容易夭折；其中每一次形成五线顺下，都是一轮暴跌的开始，尤其三死叉更重。",
  "source_summary": "若股价处于60/120日均线下方且五线顺下，可视为下跌2&3区间或2-3中端的强弱势状态。",
  "comment": "当前提取为更通用的‘五线顺下’结果态版本。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close"],
  "warmup_bars": 150,
  "indicator_type": "trend_rule",
  "params": {
    "ma_fast_window": 5,
    "ma_mid_window": 10,
    "ma_slow_window": 20,
    "ma_long_window": 60,
    "ma_longer_window": 120,
    "signal_keep_days": 5
  },
  "series": [
    {"id": "ma_5", "op": "sma", "field": "close", "window": "$params.ma_fast_window", "description": "5日均线"},
    {"id": "ma_10", "op": "sma", "field": "close", "window": "$params.ma_mid_window", "description": "10日均线"},
    {"id": "ma_20", "op": "sma", "field": "close", "window": "$params.ma_slow_window", "description": "20日均线"},
    {"id": "ma_60", "op": "sma", "field": "close", "window": "$params.ma_long_window", "description": "60日均线"},
    {"id": "ma_120", "op": "sma", "field": "close", "window": "$params.ma_longer_window", "description": "120日均线"}
  ],
  "events": [],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {"op": "compare", "left": "close", "operator": "<", "right": "ma_60"},
          {"op": "compare", "left": "close", "operator": "<", "right": "ma_120"},
          {"op": "compare", "left": "ma_5", "operator": "<", "right": "ma_10"},
          {"op": "compare", "left": "ma_10", "operator": "<", "right": "ma_20"},
          {"op": "compare", "left": "ma_20", "operator": "<", "right": "ma_60"},
          {"op": "compare", "left": "ma_60", "operator": "<", "right": "ma_120"}
        ]
      }
    }
  },
  "calculation_steps": [
    "计算5/10/20/60/120日均线。",
    "要求股价位于60日和120日均线之下。",
    "要求5<10<20<60<120，近似表达五线顺下与冷空气带压制。"
  ],
  "signal_day_definition": "以五线顺下格局形成并处于60/120日均线之下的当日作为下跌主区间信号日。",
  "manual_review_needed": [
    "原文强调每次五线顺下都可能诱发暴跌，并特别指出三死叉更强，当前 latest_match 只保留五线顺下主结构。"
  ],
  "implementation_notes": [
    "可与三死叉见顶类规则联用，强化下跌中段筛选。"
  ],
  "explain": "均线2+3（五）被结构化为冷空气带之下的五线顺下弱势区。"
}
