{
  "name": "价压",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [56, 57, 58, 59, 60],
  "source": "价压由5日、10日、20日均线在高位依次向下死叉形成封闭三角形，通常是头部的代表性信号。",
  "source_summary": "5/10/20日均线在高位按顺序形成三个向下交叉并转为空头排列，可视为价压。",
  "comment": "这是价托的对称反向版本，当前按日线头部均线三角压结构提取。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close"],
  "warmup_bars": 60,
  "indicator_type": "pattern_rule",
  "params": {
    "ma_fast_window": 5,
    "ma_mid_window": 10,
    "ma_slow_window": 20,
    "background_lookback": 20,
    "background_min_bullish_days": 3,
    "sequence_lookback": 20,
    "post_confirm_lookback": 5,
    "allow_same_day": true
  },
  "series": [
    {
      "id": "ma_fast",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_fast_window",
      "description": "5日均线"
    },
    {
      "id": "ma_mid",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_mid_window",
      "description": "10日均线"
    },
    {
      "id": "ma_slow",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_slow_window",
      "description": "20日均线"
    }
  ],
  "events": [
    {
      "id": "cross_fast_mid",
      "op": "cross_down",
      "left": "ma_fast",
      "right": "ma_mid",
      "description": "5日均线下穿10日均线"
    },
    {
      "id": "cross_fast_slow",
      "op": "cross_down",
      "left": "ma_fast",
      "right": "ma_slow",
      "description": "5日均线下穿20日均线"
    },
    {
      "id": "cross_mid_slow",
      "op": "cross_down",
      "left": "ma_mid",
      "right": "ma_slow",
      "description": "10日均线下穿20日均线"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "and",
      "conditions": [
        {
          "op": "before",
          "condition": {
            "op": "and",
            "conditions": [
              {
                "op": "compare",
                "left": "ma_fast",
                "operator": ">",
                "right": "ma_mid"
              },
              {
                "op": "compare",
                "left": "ma_mid",
                "operator": ">",
                "right": "ma_slow"
              }
            ]
          },
          "event": "cross_fast_mid",
          "window": "$params.background_lookback",
          "min_count": "$params.background_min_bullish_days"
        },
        {
          "op": "sequence",
          "window": "$params.sequence_lookback",
          "allow_same_day": "$params.allow_same_day",
          "conditions": [
            {
              "op": "condition",
              "event": "cross_fast_mid"
            },
            {
              "op": "condition",
              "event": "cross_fast_slow"
            },
            {
              "op": "condition",
              "event": "cross_mid_slow"
            }
          ]
        },
        {
          "op": "within",
          "window": "$params.post_confirm_lookback",
          "condition": {
            "op": "condition",
            "event": "cross_mid_slow"
          }
        },
        {
          "op": "compare",
          "left": "ma_fast",
          "operator": "<=",
          "right": "ma_mid"
        },
        {
          "op": "compare",
          "left": "ma_mid",
          "operator": "<=",
          "right": "ma_slow"
        }
      ]
    }
  },
  "calculation_steps": [
    "计算5/10/20日均线。",
    "要求在头部前先出现 ma_fast > ma_mid > ma_slow 的多头背景。",
    "在最近sequence_lookback日内检测三个依次出现的死亡交叉。",
    "要求最新交易日仍在post_confirm_lookback日内，且均线保持空头顺序。"
  ],
  "signal_day_definition": "以10日均线下穿20日均线的当日作为价压完成日。",
  "manual_review_needed": [
    "原文中的高位背景和头部盘整尚未单独参数化，当前主要保留均线结构本身。"
  ],
  "implementation_notes": [
    "价压是价托的镜像规则。",
    "如果后续需要更严格头部定位，可增加前高区间或涨幅条件。"
  ],
  "explain": "价压表示均线系统由多头向空头的封闭三角扭转。"
}
