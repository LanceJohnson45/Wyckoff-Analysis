{
  "name": "大死爪",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [779, 780, 781, 782],
  "source": "大死爪是由20、60、120日均线在头部区域共同向下扭转并形成空头爪状扩散的长期死亡形态，若同时跌破头部筷子线、OBV均线或关键水平支撑，则往往意味着头部确立、后续跌势难免。",
  "source_summary": "若20/60/120日均线在短窗口内完成向下共振，且价格跌破重要支撑并位于三线下方，可视为大死爪成立。",
  "comment": "当前先提取最可执行的日线主干：20/60/120三线向下共振，加上价格破位确认。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close"],
  "warmup_bars": 180,
  "indicator_type": "trend_rule",
  "params": {
    "ma_fast_window": 20,
    "ma_mid_window": 60,
    "ma_slow_window": 120,
    "cluster_window": 12,
    "breakdown_lookback": 40,
    "signal_keep_days": 8,
    "allow_same_day": true
  },
  "series": [
    {
      "id": "ma_20",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_fast_window",
      "description": "20日均线"
    },
    {
      "id": "ma_60",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_mid_window",
      "description": "60日均线"
    },
    {
      "id": "ma_120",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_slow_window",
      "description": "120日均线"
    },
    {
      "id": "support_low",
      "op": "lowest",
      "field": "close",
      "window": "$params.breakdown_lookback",
      "description": "头部关键支撑位的收盘近似"
    },
    {
      "id": "support_low_prev",
      "op": "ref",
      "field": "support_low",
      "window": 1,
      "description": "前一日关键支撑位"
    }
  ],
  "events": [
    {
      "id": "cross_20_60_down",
      "op": "cross_down",
      "left": "ma_20",
      "right": "ma_60",
      "description": "20日均线下穿60日均线"
    },
    {
      "id": "cross_20_120_down",
      "op": "cross_down",
      "left": "ma_20",
      "right": "ma_120",
      "description": "20日均线下穿120日均线"
    },
    {
      "id": "cross_60_120_down",
      "op": "cross_down",
      "left": "ma_60",
      "right": "ma_120",
      "description": "60日均线下穿120日均线"
    },
    {
      "id": "breakdown_support",
      "op": "breakout_down",
      "left": "close",
      "right": "support_low_prev",
      "description": "跌破头部关键支撑位"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "sequence",
            "window": "$params.cluster_window",
            "allow_same_day": "$params.allow_same_day",
            "conditions": [
              {
                "op": "condition",
                "event": "cross_20_60_down"
              },
              {
                "op": "condition",
                "event": "cross_20_120_down"
              },
              {
                "op": "condition",
                "event": "cross_60_120_down"
              }
            ]
          },
          {
            "op": "condition",
            "event": "breakdown_support"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": "<",
            "right": "ma_20"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": "<",
            "right": "ma_60"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": "<",
            "right": "ma_120"
          }
        ]
      }
    }
  },
  "calculation_steps": [
    "计算20、60、120日均线，识别长期均线系统的向下交叉共振。",
    "在cluster_window窗口内要求20/60/120三组死叉相继完成，近似大死爪张开。",
    "同时要求收盘跌破近阶段关键支撑位并位于三线下方，作为头部确立确认。"
  ],
  "signal_day_definition": "以20/60/120三线向下共振后再次跌破关键支撑位的当日作为大死爪确认日。",
  "manual_review_needed": [
    "原文还结合OBV死叉和下跌筷子线破位确认，当前主规则未纳入这些辅助条件。"
  ],
  "implementation_notes": [
    "warmup_bars >= ma_slow_window + breakdown_lookback + 1。"
  ],
  "explain": "大死爪被结构化为20/60/120日均线的长期向下共振，再叠加价格破位确认。"
}
