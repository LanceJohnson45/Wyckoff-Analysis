{
  "name": "季均线挤出大黑马",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [34, 35, 36, 37, 38, 39],
  "source": "该指标强调20日、40日、60日均线组成的季价托，最好是均线自然扭转形成季托，并配合左平台、右平台以及放量突破平台线，作为强势黑马信号。",
  "source_summary": "20/40/60日均线形成强势季价托并伴随平台突破时，可视为季均线挤出大黑马。",
  "comment": "当前按日线强势季价托与平台突破规则提取；左右平台的“空间高度尽量高、时间尽量长”已简化。",
  "computable_from_daily_ocvhl": true,
  "required_fields": [
    "close",
    "volume"
  ],
  "warmup_bars": 120,
  "indicator_type": "pattern_rule",
  "params": {
    "ma_fast_window": 20,
    "ma_mid_window": 40,
    "ma_slow_window": 60,
    "background_lookback": 40,
    "background_min_bearish_days": 5,
    "sequence_lookback": 40,
    "post_confirm_lookback": 10,
    "breakout_lookback": 40,
    "allow_same_day": true
  },
  "series": [
    {
      "id": "ma_fast",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_fast_window",
      "description": "20日均线"
    },
    {
      "id": "ma_mid",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_mid_window",
      "description": "40日均线"
    },
    {
      "id": "ma_slow",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_slow_window",
      "description": "60日均线"
    },
    {
      "id": "close_high_lookback",
      "op": "highest",
      "field": "close",
      "window": "$params.breakout_lookback",
      "description": "最近N日收盘价最高值"
    },
    {
      "id": "close_high_prev",
      "op": "ref",
      "field": "close_high_lookback",
      "window": 1,
      "description": "前一日最近N日收盘价最高值"
    },
    {
      "id": "vol_ma_10",
      "op": "sma",
      "field": "volume",
      "window": 10,
      "description": "10日均量"
    }
  ],
  "events": [
    {
      "id": "cross_fast_mid",
      "op": "cross_up",
      "left": "ma_fast",
      "right": "ma_mid",
      "description": "20日均线上穿40日均线"
    },
    {
      "id": "cross_fast_slow",
      "op": "cross_up",
      "left": "ma_fast",
      "right": "ma_slow",
      "description": "20日均线上穿60日均线"
    },
    {
      "id": "cross_mid_slow",
      "op": "cross_up",
      "left": "ma_mid",
      "right": "ma_slow",
      "description": "40日均线上穿60日均线"
    },
    {
      "id": "breakout_prev_high",
      "op": "breakout_up",
      "left": "close",
      "right": "close_high_prev",
      "description": "突破季托上平台"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "and",
      "conditions": [
        {
          "op": "before",
          "condition": {
            "op": "and",
            "conditions": [
              {
                "op": "compare",
                "left": "ma_slow",
                "operator": ">",
                "right": "ma_mid"
              },
              {
                "op": "compare",
                "left": "ma_mid",
                "operator": ">",
                "right": "ma_fast"
              }
            ]
          },
          "event": "cross_fast_mid",
          "window": "$params.background_lookback",
          "min_count": "$params.background_min_bearish_days"
        },
        {
          "op": "sequence",
          "window": "$params.sequence_lookback",
          "allow_same_day": "$params.allow_same_day",
          "conditions": [
            {
              "op": "condition",
              "event": "cross_fast_mid"
            },
            {
              "op": "condition",
              "event": "cross_fast_slow"
            },
            {
              "op": "condition",
              "event": "cross_mid_slow"
            }
          ]
        },
        {
          "op": "within",
          "window": "$params.post_confirm_lookback",
          "condition": {
            "op": "condition",
            "event": "cross_mid_slow"
          }
        },
        {
          "op": "condition",
          "event": "breakout_prev_high"
        },
        {
          "op": "compare",
          "left": "volume",
          "operator": ">",
          "right": "vol_ma_10"
        },
        {
          "op": "and",
          "conditions": [
            {
              "op": "compare",
              "left": "ma_fast",
              "operator": ">=",
              "right": "ma_mid"
            },
            {
              "op": "compare",
              "left": "ma_mid",
              "operator": ">=",
              "right": "ma_slow"
            }
          ]
        }
      ]
    }
  },
  "calculation_steps": [
    "计算20/40/60日均线、10日均量以及最近breakout_lookback日平台前高。",
    "要求突破前存在 ma_slow > ma_mid > ma_fast 的弱势背景。",
    "在sequence_lookback窗口内检测20/40/60均线三次向上交叉形成季价托。",
    "要求最新交易日处于post_confirm_lookback窗口内，且价格已突破平台、成交量高于10日均量。"
  ],
  "signal_day_definition": "以季价托完成后向上突破平台并放量的当日作为强势季托信号日。",
  "manual_review_needed": [
    "左平台、右平台的形态要求在原文中较强，但当前仅用近期平台突破近似表达。",
    "“自然扭转”未单独建模，当前通过先前弱势背景与后续顺序金叉近似表达。"
  ],
  "implementation_notes": [
    "该指标是价托在20/40/60日均线上的强势变体。",
    "如果后续需要更严格区分自然扭转与反弹形成的季托，建议引擎增加平台跨度和斜率算子。"
  ],
  "explain": "这里把强势季价托收敛成一个可执行规则：季托完成、放量、突破平台。"
}
