{
  "name": "五均线向下发散",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [496, 497],
  "source": "五均线向下发散，是指5日、10日、20日、60日、120日五条均线在空头排列的基础上继续向下张开，释放做空动能。原文指出，一旦五均线向下发散，往往意味着后续再出现大反弹的概率较低，应利用反弹高点离场。",
  "source_summary": "若五条均线空头排列且短长均线之间的负向距离继续扩大，可视为五均线向下发散。",
  "comment": "该规则相对‘五线顺下’进一步强调均线之间的发散扩大。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close"],
  "warmup_bars": 150,
  "indicator_type": "trend_rule",
  "params": {
    "signal_keep_days": 5
  },
  "series": [
    {
      "id": "ma_5",
      "op": "sma",
      "field": "close",
      "window": 5,
      "description": "5日均线"
    },
    {
      "id": "ma_10",
      "op": "sma",
      "field": "close",
      "window": 10,
      "description": "10日均线"
    },
    {
      "id": "ma_20",
      "op": "sma",
      "field": "close",
      "window": 20,
      "description": "20日均线"
    },
    {
      "id": "ma_60",
      "op": "sma",
      "field": "close",
      "window": 60,
      "description": "60日均线"
    },
    {
      "id": "ma_120",
      "op": "sma",
      "field": "close",
      "window": 120,
      "description": "120日均线"
    },
    {
      "id": "spread_5_120",
      "op": "sub",
      "field": "ma_5",
      "field2": "ma_120",
      "window": 0,
      "description": "5日线与120日线的差值"
    },
    {
      "id": "spread_5_120_prev",
      "op": "ref",
      "field": "spread_5_120",
      "window": 1,
      "description": "前一日5日线与120日线差值"
    }
  ],
  "events": [],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "compare",
            "left": "ma_5",
            "operator": "<",
            "right": "ma_10"
          },
          {
            "op": "compare",
            "left": "ma_10",
            "operator": "<",
            "right": "ma_20"
          },
          {
            "op": "compare",
            "left": "ma_20",
            "operator": "<",
            "right": "ma_60"
          },
          {
            "op": "compare",
            "left": "ma_60",
            "operator": "<",
            "right": "ma_120"
          },
          {
            "op": "compare",
            "left": "spread_5_120",
            "operator": "<",
            "right": "spread_5_120_prev"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": "<",
            "right": "ma_5"
          }
        ]
      }
    }
  },
  "calculation_steps": [
    "计算5/10/20/60/120日均线。",
    "要求均线先形成标准空头排列。",
    "再要求5日线与120日线的负向差值较前一日继续扩大，近似表达向下发散。"
  ],
  "signal_day_definition": "以五条均线空头排列且5日线相对120日线继续向下扩散的当日作为信号日。",
  "manual_review_needed": [
    "原文中的‘真正暴跌通常发生在小平台被再次打穿时’，当前未加入平台破位子规则。"
  ],
  "implementation_notes": [
    "warmup_bars >= 120 + 1。"
  ],
  "explain": "该规则用于区分普通空头排列与均线继续向下扩张的更强杀跌阶段。"
}
