{
  "name": "压价逼仓",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [256, 257],
  "source": "压价逼仓发生在60日均线下方，股价仍处于底部区间，庄家通过一次或两次压价把散户逼到地板上割肉；典型表现为60线下的小W底，若UP2的最低点高于UP1则说明底部抬高、走势较强。",
  "source_summary": "若60日线下形成底部抬高的小W底，可视为压价逼仓完成。",
  "comment": "当前提取为偏强版本：60日线下的小W底，且第二个低点高于第一个低点。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close"],
  "warmup_bars": 100,
  "indicator_type": "pattern_rule",
  "params": {
    "ma_long_window": 60,
    "low_window": 10,
    "signal_keep_days": 5
  },
  "series": [
    {"id": "ma_long", "op": "sma", "field": "close", "window": "$params.ma_long_window", "description": "60日均线"},
    {"id": "recent_low", "op": "lowest", "field": "close", "window": "$params.low_window", "description": "近期低点近似"},
    {"id": "recent_low_ref_10", "op": "ref", "field": "recent_low", "window": 10, "description": "较早一段的低点近似"}
  ],
  "events": [],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {"op": "compare", "left": "close", "operator": "<", "right": "ma_long"},
          {"op": "compare", "left": "recent_low", "operator": ">", "right": "recent_low_ref_10"}
        ]
      }
    }
  },
  "calculation_steps": [
    "计算60日均线，要求股价仍位于其下方。",
    "用两个相邻低点窗口近似UP1与UP2。",
    "要求第二个低点高于第一个低点，近似底部抬高的小W底。"
  ],
  "signal_day_definition": "当60日线下的小W底抬高结构在最新交易日仍成立时，视为压价逼仓有效。",
  "manual_review_needed": [
    "原文中的UP1、UP2和压价逼仓节奏未逐段精确建模，当前只保留底部抬高这个最核心判据。"
  ],
  "implementation_notes": [
    "这是底部庄家逼仓识别规则。"
  ],
  "explain": "压价逼仓被结构化为60日线下底部抬高的小W底洗盘形态。"
}
