{
  "name": "大刀砍",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [821, 822, 823, 824, 825],
  "source": "大刀砍是主升浪启动后的第一次快速深跌，跌速快、跌幅深，甚至一举跌破60日均线；其后通常会出现一个缺量弹跳，若再接断头铡刀，则头部确立无疑。",
  "source_summary": "若股价在高位快速深跌并跌破60日均线，随后弹跳乏力，可视为大刀砍成立。",
  "comment": "当前先提取日线版‘快速深跌破60线 + 弱反弹’主干，作为头部预警而非完整出货路径。"
  ,
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close", "volume"],
  "warmup_bars": 100,
  "indicator_type": "trend_rule",
  "params": {
    "ma_long_window": 60,
    "drop_lookback": 10,
    "drop_pct": -0.15,
    "bounce_lookback": 5,
    "signal_keep_days": 8
  },
  "series": [
    {
      "id": "ma_60",
      "op": "sma",
      "field": "close",
      "window": "$params.ma_long_window",
      "description": "60日均线"
    },
    {
      "id": "drop_pct_10",
      "op": "pct_change",
      "field": "close",
      "window": "$params.drop_lookback",
      "description": "近10日累计涨跌幅"
    },
    {
      "id": "close_ref_5",
      "op": "ref",
      "field": "close",
      "window": "$params.bounce_lookback",
      "description": "5日前收盘价"
    },
    {
      "id": "volume_ma_5",
      "op": "sma",
      "field": "volume",
      "window": 5,
      "description": "5日均量"
    }
  ],
  "events": [
    {
      "id": "breakdown_60",
      "op": "cross_down",
      "left": "close",
      "right": "ma_60",
      "description": "收盘跌破60日均线"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "condition",
            "event": "breakdown_60"
          },
          {
            "op": "compare",
            "left": "drop_pct_10",
            "operator": "<=",
            "right": "$params.drop_pct"
          },
          {
            "op": "compare",
            "left": "close",
            "operator": "<",
            "right": "close_ref_5"
          }
        ]
      }
    }
  },
  "calculation_steps": [
    "计算60日均线与近10日累计跌幅。",
    "要求股价在较短时间内出现较大跌幅并收盘跌破60日均线。",
    "同时要求当前价格明显低于数日前收盘，以近似原文中的快速深跌冲击。"
  ],
  "signal_day_definition": "以快速深跌并跌破60日均线的当日作为大刀砍确认日。",
  "manual_review_needed": [
    "原文还强调后续必有弹跳及与断头铡刀组合判断，当前主规则只提取第一次大规模出货的预警动作。"
  ],
  "implementation_notes": [
    "这是高位急跌风险的日线近似版本。"
  ],
  "explain": "大刀砍被结构化为高位快速深跌并跌破60日均线的头部预警信号。"
}
