{
  "name": "油管畅通",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [837, 838, 839],
  "source": "油管畅通是空中加油中的强势细节：在空中盘旋或横盘蓄势时，只要5日均线与10日均线不死叉、保持通气，就说明回档浅、盘整时间短；若同时MACD、OBV等油管也畅通，则后续突破更强。",
  "source_summary": "若股价盘整时5日与10日均线保持通气且未死叉，随后向上突破平台，可视为油管畅通成立。",
  "comment": "当前先提取最核心的日线油管：5/10均线不死叉 + 平台突破。"
  ,
  "computable_from_daily_ocvhl": true,
  "required_fields": ["close"],
  "warmup_bars": 40,
  "indicator_type": "breakout_rule",
  "params": {
    "platform_lookback": 15,
    "signal_keep_days": 5
  },
  "series": [
    {
      "id": "ma_5",
      "op": "sma",
      "field": "close",
      "window": 5,
      "description": "5日均线"
    },
    {
      "id": "ma_10",
      "op": "sma",
      "field": "close",
      "window": 10,
      "description": "10日均线"
    },
    {
      "id": "platform_high",
      "op": "highest",
      "field": "close",
      "window": "$params.platform_lookback",
      "description": "盘旋平台高点近似"
    },
    {
      "id": "platform_high_prev",
      "op": "ref",
      "field": "platform_high",
      "window": 1,
      "description": "前一日平台高点"
    }
  ],
  "events": [
    {
      "id": "breakout_platform",
      "op": "breakout_up",
      "left": "close",
      "right": "platform_high_prev",
      "description": "突破空中盘旋平台"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "compare",
            "left": "ma_5",
            "operator": ">=",
            "right": "ma_10"
          },
          {
            "op": "condition",
            "event": "breakout_platform"
          }
        ]
      }
    }
  },
  "calculation_steps": [
    "计算5日与10日均线，要求两线保持通气而非死叉。",
    "在盘整平台窗口内寻找平台高点。",
    "当股价向上突破平台高点且5/10均线仍保持畅通时，视为油管畅通成立。"
  ],
  "signal_day_definition": "以5/10均线保持畅通且股价突破盘整平台的当日作为油管畅通确认日。",
  "manual_review_needed": [
    "原文还结合MACD、OBV和分时油管畅通，当前主规则只保留日线均线油管。"
  ],
  "implementation_notes": [
    "这是空中加油细节中的强势筛选版本。"
  ],
  "explain": "油管畅通被结构化为5/10均线未死叉的短平台突破信号。"
}
