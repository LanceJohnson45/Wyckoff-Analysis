{
  "name": "悬空 K 线群",
  "status": "structured",
  "timeframe": "1d",
  "source_pages": [787, 788, 789, 790],
  "source": "悬空K线群是停牌复牌或突发基本面变化后形成的一组跳空巨量K线；若无法直接看到L3主动性买卖量，可以把这组悬空K线的高低点框出来，向上突破高点线说明主力偏向继续建仓并可跟进，向下跌破低点线则说明风险更大。",
  "source_summary": "若悬空K线群形成后，股价放量突破其上沿，可视为悬空K线群向上突破成立。",
  "comment": "当前优先输出原文强调的向上突破跟进版本，不额外输出向下破位风险镜像文件。",
  "computable_from_daily_ocvhl": true,
  "required_fields": ["open", "close", "volume"],
  "warmup_bars": 80,
  "indicator_type": "breakout_rule",
  "params": {
    "cluster_lookback": 20,
    "volume_ma_window": 20,
    "min_gap_days": 1,
    "signal_keep_days": 5
  },
  "series": [
    {
      "id": "cluster_high",
      "op": "highest",
      "field": "close",
      "window": "$params.cluster_lookback",
      "description": "悬空K线群上沿近似"
    },
    {
      "id": "cluster_high_prev",
      "op": "ref",
      "field": "cluster_high",
      "window": 1,
      "description": "前一日悬空K线群上沿"
    },
    {
      "id": "prev_high",
      "op": "ref",
      "field": "high",
      "window": 1,
      "description": "前一日最高价"
    },
    {
      "id": "volume_ma",
      "op": "sma",
      "field": "volume",
      "window": "$params.volume_ma_window",
      "description": "20日均量"
    }
  ],
  "events": [
    {
      "id": "gap_up_open",
      "op": "breakout_up",
      "left": "open",
      "right": "prev_high",
      "description": "向上跳空开盘"
    },
    {
      "id": "breakout_cluster",
      "op": "breakout_up",
      "left": "close",
      "right": "cluster_high_prev",
      "description": "向上突破悬空K线群上沿"
    }
  ],
  "rules": {
    "latest_match": {
      "op": "within",
      "window": "$params.signal_keep_days",
      "condition": {
        "op": "and",
        "conditions": [
          {
            "op": "before",
            "condition": {
              "op": "condition",
              "event": "gap_up_open"
            },
            "event": "breakout_cluster",
            "window": "$params.cluster_lookback",
            "min_count": "$params.min_gap_days"
          },
          {
            "op": "condition",
            "event": "breakout_cluster"
          },
          {
            "op": "compare",
            "left": "volume",
            "operator": ">",
            "right": "volume_ma"
          }
        ]
      }
    }
  },
  "calculation_steps": [
    "用近阶段窗口近似悬空K线群的上沿，并记录跳空开盘事件。",
    "要求在形成悬空K线群的窗口内至少出现一次向上跳空开盘，近似复牌或突发事件造成的断裂。",
    "当收盘价放量突破悬空K线群上沿时，视为向上突破成立。"
  ],
  "signal_day_definition": "以放量突破悬空K线群上沿的当日作为跟进确认日。",
  "manual_review_needed": [
    "原文还强调可结合OBV与L3主动性买卖量区分建仓和出货，当前仅保留形态突破版本。"
  ],
  "implementation_notes": [
    "当前把‘悬空K线群’收敛为近窗口中的跳空断裂群体及其边界突破。"
  ],
  "explain": "悬空K线群被结构化为跳空断裂形成的群体上沿突破信号。"
}
